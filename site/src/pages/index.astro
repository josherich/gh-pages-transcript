---
import Archive from "../layouts/Archive.astro";
import { displayDate, getTranscripts, sitePath } from "../lib/transcripts";

const transcripts = await getTranscripts();
const shows = [...new Set(transcripts.map(({ show }) => show).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));
---
<Archive>
  <h1>Podcast Transcripts</h1>
  <p>Browse transcripts from podcasts and videos collected by Josherich.</p>
  <form class="filters" hidden role="search" aria-label="Filter transcripts">
    <label>
      Search titles
      <input type="search" name="query" autocomplete="off" />
    </label>
    <label>
      Show
      <select name="show">
        <option value="">All shows</option>
        {shows.map((show) => <option value={show}>{show}</option>)}
      </select>
    </label>
  </form>
  <p class="count" aria-live="polite">{transcripts.length} transcripts</p>
  <ul class="archive">
    {transcripts.map(({ entry: { data }, path, show }) => (
      <li data-title={data.title} data-show={show}>
        <time datetime={data.date.toISOString().slice(0, 10)}>{displayDate(data.date)}</time>
        <a class="episode" href={sitePath(path)}>{data.title}</a>
        {show && <span class="show">{show}</span>}
      </li>
    ))}
  </ul>
</Archive>

<script>
  const form = document.querySelector<HTMLFormElement>(".filters")!;
  const query = form.querySelector("input")!;
  const show = form.querySelector("select")!;
  const count = document.querySelector(".count")!;
  const entries = [...document.querySelectorAll<HTMLLIElement>(".archive li")];

  function filter() {
    const terms = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let matches = 0;
    for (const item of entries) {
      const title = (item.dataset.title || "").toLowerCase();
      item.hidden = Boolean(show.value && item.dataset.show !== show.value)
        || !terms.every((term) => title.includes(term));
      if (!item.hidden) matches++;
    }
    count.textContent = matches === 1 ? "1 transcript" : matches + " transcripts";
  }

  const selected = new URLSearchParams(location.search).get("show");
  if (selected && [...show.options].some((option) => option.value === selected)) show.value = selected;
  form.addEventListener("input", filter);
  form.addEventListener("submit", (event) => event.preventDefault());
  form.hidden = false;
  filter();
</script>

<style>
  h1 + p { color: var(--subtle); margin: 0 0 2rem; }
  .filters { display: flex; gap: 1rem; flex-wrap: wrap; }
  label { display: grid; flex: 1 1 14rem; gap: 0.35rem; font-size: 0.875rem; }
  input, select {
    font: inherit;
    color: var(--foreground);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.4em;
    min-width: 0;
    min-height: 2.6rem;
    padding: 0.45rem 0.65rem;
  }
  .count { color: var(--subtle); font-size: 0.9rem; margin: 1.5rem 0 0.5rem; }
  .archive { border-top: 1px solid var(--border); list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    align-items: baseline;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  time, .show { color: var(--subtle); font-size: 0.875rem; }
  .episode { font-weight: 550; }
  .show { grid-column: 2; margin-top: 0.15rem; }
  @media (max-width: 33rem) {
    li { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
    .show { grid-column: 1; }
  }
</style>
